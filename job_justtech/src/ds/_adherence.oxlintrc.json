{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/buttons/**",
              "components/cells/**",
              "components/forms/**",
              "components/icons/**",
              "components/media/**",
              "components/navigation/**",
              "components/site/**",
              "ui_kits/student_app/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat|Roboto))/i]",
        "message": "Font not provided by the design system. Available: Montserrat, Roboto."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:scheme|state|icon|children|key|ref|className|style|children)$/]",
        "message": "<ActionButton> doesn't accept that prop. Declared props: scheme, state, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionButton'] > JSXAttribute[name.name='scheme'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<ActionButton> scheme must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionButton'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|hover|pressed|disabled)$/]",
        "message": "<ActionButton> state must be one of 'default' | 'hover' | 'pressed' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AddAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|icon|key|ref|className|style|children)$/]",
        "message": "<AddAction> doesn't accept that prop. Declared props: state, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='AddAction'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|hover|pressed|disabled)$/]",
        "message": "<AddAction> state must be one of 'default' | 'hover' | 'pressed' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:scheme|state|loading|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: scheme, state, loading, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='scheme'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<Button> scheme must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|hover|pressed|disabled)$/]",
        "message": "<Button> state must be one of 'default' | 'hover' | 'pressed' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CellHeadline'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|children|key|ref|className|style|children)$/]",
        "message": "<CellHeadline> doesn't accept that prop. Declared props: width, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CellMain'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|children|key|ref|className|style|children)$/]",
        "message": "<CellMain> doesn't accept that prop. Declared props: width, children."
